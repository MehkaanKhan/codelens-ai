{
  "name": "codelens-ai",
  "displayName": "CodeLens AI",
  "description": "AI-powered codebase intelligence for VS Code — offline, local LLM",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "codelens-ai",
        "name": "codelens-ai",
        "fullName": "CodeLens AI",
        "description": "Ask anything about your indexed codebase — runs fully offline",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "codelens-ai.openChat",
        "title": "CodeLens AI: Open Chat"
      },
      {
        "command": "codelens-ai.openConverter",
        "title": "CodeLens AI: Open Code Converter"
      },
      {
        "command": "codelens-ai.openGraph",
        "title": "CodeLens AI: Open Dependency Graph"
      },
      {
        "command": "codelens-ai.indexRepo",
        "title": "CodeLens AI: Index Current Workspace"
      }
    ],
    "configuration": {
      "title": "CodeLens AI",
      "properties": {
        "codelens-ai.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python interpreter used to run the backend server."
        },
        "codelens-ai.backendPort": {
          "type": "number",
          "default": 8080,
          "description": "Port the FastAPI backend listens on."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "clang-format": "^1.8.0",
    "eslint": "^9.39.3",
    "prettier": "^3.8.3",
    "prettier-plugin-java": "^2.9.7",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
